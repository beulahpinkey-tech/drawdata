{
  "name": "drawdata",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "precompute": "tsx scripts/precompute.ts",
    "ingest": "tsx scripts/precompute.ts",
    "verify": "tsx scripts/verify.ts && tsx scripts/verify-isolation.ts && tsx scripts/verify-links.ts",
    "verify:links": "tsx scripts/verify-links.ts",
    "verify:isolation": "tsx scripts/verify-isolation.ts",
    "export": "tsx scripts/export-all.ts",
    "fetch:pa": "tsx scripts/fetch-pa.ts",
    "fetch:nj": "tsx scripts/fetch-nj.ts",
    "fetch:tx": "tsx scripts/fetch-tx.ts",
    "fetch:nc": "tsx scripts/fetch-nc.ts",
    "fetch:fl": "tsx scripts/fetch-fl.ts",
    "fetch:wa": "tsx scripts/fetch-wa.ts",
    "fetch:il": "tsx scripts/fetch-il.ts",
    "fetch:wi": "tsx scripts/fetch-wi.ts",
    "fetch:mm": "tsx scripts/fetch-mm.ts",
    "fetch:powerball": "tsx scripts/fetch-powerball.ts",
    "fetch:all": "npm run fetch:wi && npm run fetch:pa && npm run fetch:nj && npm run fetch:tx && npm run fetch:nc && npm run fetch:fl && npm run fetch:wa && npm run fetch:mm && npm run fetch:powerball",
    "clean:next": "node scripts/clean-next.mjs",
    "predev": "npm run clean:next && npm run precompute",
    "prebuild": "npm run clean:next && npm run precompute",
    "dev": "next dev",
    "build": "next build",
    "build:cf": "npm run precompute && npx @cloudflare/next-on-pages",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "framer-motion": "^11.18.2",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-zoom-pan-pinch": "^3.7.0",
    "recharts": "2.12.7",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/three": "^0.169.0",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.7",
    "tsx": "4.19.0",
    "typescript": "5.5.3"
  }
}
