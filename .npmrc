# Cloudflare's build runs `npx @cloudflare/next-on-pages`, which installs
# next-on-pages + a floating `wrangler` fresh each build. A newer wrangler
# (4.114.x) peers on @cloudflare/workers-types@^5 while next-on-pages@1.13
# peers on ^4 — an ERESOLVE conflict that failed every Pages build (and
# froze deploys) starting ~2026-07. Peers here are build/deploy tooling,
# not runtime code, so tolerating the mismatch is safe and unblocks builds.
legacy-peer-deps=true
